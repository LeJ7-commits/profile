{
  "$description": "Design tokens for jay-le-portfolio (W3C DTCG format). Adapted from the 'monopo saigon' style reference — see design/DESIGN.md. Runtime source: src/styles/tokens.css; keep both in sync.",
  "color": {
    "obsidian": { "$value": "#000000", "$type": "color", "$description": "Primary text, marks, inverse surfaces" },
    "paper": { "$value": "#ffffff", "$type": "color", "$description": "Canvas; text on dark" },
    "inkstone": { "$value": "#181818", "$type": "color", "$description": "Long-form body copy" },
    "felt": { "$value": "#6d6d6d", "$type": "color", "$description": "Muted helper text, captions" },
    "slate": { "$value": "#636363", "$type": "color", "$description": "The one filled neutral surface" },
    "ash": { "$value": "#9a9a9a", "$type": "color", "$description": "Muted text on obsidian" },
    "pewter": { "$value": "#808080", "$type": "color", "$description": "Hover / muted state layers" },
    "hairline": { "$value": "rgba(0,0,0,0.14)", "$type": "color", "$description": "1px rules on paper" },
    "hairline-inverse": { "$value": "rgba(255,255,255,0.3)", "$type": "color", "$description": "1px rules and ghost-pill borders on obsidian" }
  },
  "aurora": {
    "$description": "Personal re-grade of the reference's iridescent hero media. Media only — never text, borders or controls.",
    "1": { "$value": "#7cf2c5", "$type": "color", "$description": "Aurora green" },
    "2": { "$value": "#5ab8ff", "$type": "color", "$description": "Glacier blue" },
    "3": { "$value": "#8b5cf6", "$type": "color", "$description": "Violet dusk" },
    "4": { "$value": "#140b3a", "$type": "color", "$description": "Night indigo" }
  },
  "font": {
    "sans": { "$value": ["Roobert", "Inter Variable", "Inter", "system-ui", "sans-serif"], "$type": "fontFamily" },
    "mono": { "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$type": "fontFamily" }
  },
  "fontWeight": {
    "light": { "$value": 300, "$type": "fontWeight" },
    "normal": { "$value": 400, "$type": "fontWeight" },
    "semibold": { "$value": 600, "$type": "fontWeight" }
  },
  "fontSize": {
    "micro": { "$value": "11px", "$type": "dimension" },
    "caption": { "$value": "12px", "$type": "dimension" },
    "body-sm": { "$value": "16px", "$type": "dimension" },
    "body": { "$value": "18px", "$type": "dimension" },
    "lede": { "$value": "29px", "$type": "dimension", "$description": "Fluid: clamp(22px, 2.6vw, 29px)" },
    "subheading": { "$value": "39px", "$type": "dimension", "$description": "Fluid from 28px" },
    "subheading-lg": { "$value": "45px", "$type": "dimension", "$description": "Fluid from 32px" },
    "heading-sm": { "$value": "54px", "$type": "dimension", "$description": "Fluid from 36px" },
    "heading": { "$value": "78px", "$type": "dimension", "$description": "Weight 300 — whisper headline. Fluid from 42px" },
    "heading-lg": { "$value": "94px", "$type": "dimension", "$description": "Fluid from 52px" },
    "display": { "$value": "225px", "$type": "dimension", "$description": "Fluid from 84px" }
  },
  "spacing": {
    "unit": { "$value": "4px", "$type": "dimension" },
    "8": { "$value": "8px", "$type": "dimension" },
    "12": { "$value": "12px", "$type": "dimension" },
    "28": { "$value": "28px", "$type": "dimension" },
    "40": { "$value": "40px", "$type": "dimension" },
    "48": { "$value": "48px", "$type": "dimension" },
    "64": { "$value": "64px", "$type": "dimension" },
    "68": { "$value": "68px", "$type": "dimension" },
    "152": { "$value": "152px", "$type": "dimension" }
  },
  "layout": {
    "page-max-width": { "$value": "1078px", "$type": "dimension" },
    "section-gap": { "$value": "46px", "$type": "dimension" },
    "card-padding": { "$value": "34px", "$type": "dimension" },
    "element-gap": { "$value": "14px", "$type": "dimension" },
    "nav-height": { "$value": "66px", "$type": "dimension" }
  },
  "radius": {
    "none": { "$value": "0px", "$type": "dimension", "$description": "Cards, images, inputs, links" },
    "pill": { "$value": "75px", "$type": "dimension", "$description": "Buttons and tags only" }
  },
  "motion": {
    "ease-glide": { "$value": [0.19, 1, 0.22, 1], "$type": "cubicBezier" },
    "duration-quick": { "$value": "400ms", "$type": "duration" },
    "duration-glide": { "$value": "800ms", "$type": "duration" },
    "duration-slow": { "$value": "1250ms", "$type": "duration" }
  }
