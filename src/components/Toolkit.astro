---
import { stack, certifications, education, languages } from '../data/profile';
import SectionHead from './SectionHead.astro';
import AuroraWash from './AuroraWash.astro';
---

<section id="toolkit" data-band="light" class="relative isolate overflow-clip py-24 md:py-38">
  <AuroraWash class="left-[-15%] top-[140px] h-[380px] w-[55%]" />
  <div class="page">
    <SectionHead index="02" label="Toolkit" title="Stack, credentials, background." />

    <div class="reveal border-t border-hairline grid gap-10 py-12 md:grid-cols-[180px_1fr] md:gap-10">
      <p class="eyebrow text-felt">Stack</p>
      <dl class="grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3">
        {stack.map((g) => (
          <div>
            <dt class="eyebrow mb-3">{g.group}</dt>
            <dd class="flex flex-col gap-1 text-body-sm text-inkstone">{g.items.map((i) => <span>{i}</span>)}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="reveal border-t border-hairline grid gap-10 py-12 md:grid-cols-[180px_1fr] md:gap-10">
      <p class="eyebrow text-felt">Certifications</p>
      <ul class="flex flex-wrap gap-3">{certifications.map((c) => <li class="tag text-caption">{c}</li>)}</ul>
    </div>

    <div class="reveal border-t border-hairline grid gap-10 py-12 md:grid-cols-[180px_1fr] md:gap-10">
      <p class="eyebrow text-felt">Education</p>
      <ul class="flex flex-col gap-6">
        {education.map((e) => (
          <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
            <span class="text-body">{e.degree}<span class="text-felt">, {e.school}</span></span>
            <span class="eyebrow text-felt shrink-0">{e.years}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="reveal border-t border-hairline grid gap-10 py-12 md:grid-cols-[180px_1fr] md:gap-10">
      <p class="eyebrow text-felt">Languages</p>
      <p class="text-body text-inkstone">{languages.join(' · ')}</p>
    </div>
  </div>
</section>
