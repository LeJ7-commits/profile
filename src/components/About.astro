---
import { profile, metrics } from '../data/profile';
---

<section id="about" data-band="light" class="py-24 md:py-38">
  <div class="page">
    <p class="eyebrow reveal mb-10 text-felt">About</p>
    <h2 class="reveal text-heading font-light tracking-[-0.02em] max-w-[18ch]" style="--i:1">{profile.manifesto}</h2>
    <div class="mt-16 grid gap-10 md:grid-cols-[180px_1fr] md:gap-10">
      <span class="hidden md:block"></span>
      <p class="reveal text-lede font-light text-inkstone max-w-[36ch]" style="--i:2">{profile.summary}</p>
    </div>

    <dl class="mt-24 grid grid-cols-1 border-t border-hairline sm:grid-cols-2 lg:grid-cols-4">
      {metrics.map((m, i) => (
        <div class="reveal flex flex-col gap-4 border-b border-hairline py-8 sm:odd:pr-8 lg:border-b-0 lg:pr-8 lg:[&:not(:first-child)]:pl-8 lg:[&:not(:first-child)]:border-l" style={`--i:${i}`}>
          <dt class="order-2 text-caption text-felt max-w-[26ch]">{m.label}</dt>
          <dd class="order-1">
            <span class="block text-subheading-lg tracking-[-0.03em] tabular-nums">{m.value}</span>
            <span class="eyebrow text-felt">{m.unit}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>
