---
import { experience } from '../data/experience';
import SectionHead from './SectionHead.astro';
import AuroraCanvas from './AuroraCanvas.astro';
import SplitText from './SplitText.astro';
---

<!-- The page's second dark band: live aurora dimmed behind the strongest proof. -->
<section id="experience" data-band="dark" class="inverse relative isolate overflow-hidden bg-obsidian text-paper py-24 md:py-38">
  <AuroraCanvas dim={0.78} />
  <div class="page">
    <SectionHead index="02" label="Experience" title="Where the numbers come from." />

    {experience.map((r, i) => (
      <article class="reveal border-t border-hairline-inverse py-12 md:py-16 grid gap-8 md:grid-cols-[180px_1fr] md:gap-10">
        <div class="flex flex-col gap-2">
          <p class="eyebrow">{r.period}</p>
          <p class="eyebrow text-ash">{r.location}</p>
        </div>
        <div>
          {i === 0 ? (
            <SplitText as="h3" text={r.company} class="text-heading-lg font-normal tracking-[-0.04em]" />
          ) : (
            <h3 class="text-subheading tracking-[-0.02em]">{r.company}</h3>
          )}
          <p class="mt-3 text-body text-ash">{r.role}</p>
          {r.intro && <p class="mt-6 text-body text-paper/90 max-w-[60ch]">{r.intro}</p>}

          {r.themes.length > 0 && (
            <div class="mt-10 grid gap-x-10 gap-y-10 lg:grid-cols-2">
              {r.themes.map((t) => (
                <div>
                  <h4 class="eyebrow mb-5 border-b border-hairline-inverse pb-3">{t.title}</h4>
                  <ul class="flex flex-col gap-4 text-body-sm text-paper/85">
                    {t.points.map((pt) => (
                      <li class="grid grid-cols-[20px_1fr]"><span class="text-ash">—</span><span>{pt}</span></li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
          )}
        </div>
      </article>
    ))}
  </div>
</section>
